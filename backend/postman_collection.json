{
  "info": {
    "_postman_id": "curryhouse-backend-collection",
    "name": "Curry House Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "authToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"phone\": \"12345678\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth","register"] }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth","login"] }
          }
        },
        {
          "name": "Get current user (me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth","me"] }
          }
        },
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"test@example.com\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/send-otp", "host": ["{{baseUrl}}"], "path": ["auth","send-otp"] }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"test@example.com\",\n  \"otp\": \"123456\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/verify-otp", "host": ["{{baseUrl}}"], "path": ["auth","verify-otp"] }
          }
        }
      ]
    },
    {
      "name": "Menu",
      "item": [
        { "name": "Get all items", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/menu", "host": ["{{baseUrl}}"], "path": ["menu"] } } },
        { "name": "Get categories", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/menu/categories", "host": ["{{baseUrl}}"], "path": ["menu","categories"] } } },
        { "name": "Create category", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\n  \"name\": \"Biryani\"\n}"}, "url": { "raw": "{{baseUrl}}/menu/categories", "host": ["{{baseUrl}}"], "path": ["menu","categories"] } } },
        { "name": "Delete category", "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/menu/categories/{name}", "host": ["{{baseUrl}}"], "path": ["menu","categories","{name}"], "variable": [{"key":"name","value":"Biryani"}] } } },
        { "name": "Get popular items", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/menu/popular/items", "host": ["{{baseUrl}}"], "path": ["menu","popular","items"] } } },
        { "name": "Get item by id", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/menu/{id}", "host": ["{{baseUrl}}"], "path": ["menu","{id}"], "variable": [{"key":"id","value":"{menuId}"}] } } },
        { "name": "Create menu item", "request": { "method": "POST", "header":[{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\n  \"name\": \"Sample Dish\",\n  \"description\": \"Tasty\",\n  \"price\": 99,\n  \"category\": \"Biryani\"\n}"}, "url": { "raw": "{{baseUrl}}/menu", "host": ["{{baseUrl}}"], "path": ["menu"] } } },
        { "name": "Update menu item", "request": { "method": "PUT", "header":[{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\n  \"name\": \"Updated Dish\"\n}"}, "url": { "raw": "{{baseUrl}}/menu/{id}", "host": ["{{baseUrl}}"], "path": ["menu","{id}"], "variable": [{"key":"id","value":"{menuId}"}] } } },
        { "name": "Delete menu item", "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/menu/{id}", "host": ["{{baseUrl}}"], "path": ["menu","{id}"], "variable": [{"key":"id","value":"{menuId}"}] } } }
      ]
    },
    {
      "name": "Orders",
      "item": [
        { "name": "Create order (auth)", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{authToken}}"}], "body": {"mode":"raw","raw":"{\n  \"items\": [{ \"menuItem\": \"{menuId}\", \"quantity\": 1 }],\n  \"deliveryAddress\": { \"street\": \"Foo\", \"city\": \"Bar\" },\n  \"paymentMethod\": \"cash\"\n}"}, "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] } } },
        { "name": "Get my orders (auth)", "request": { "method": "GET", "header":[{"key":"Authorization","value":"Bearer {{authToken}}"}], "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] } } },
        { "name": "Get order by id (auth)", "request": { "method": "GET", "header":[{"key":"Authorization","value":"Bearer {{authToken}}"}], "url": { "raw": "{{baseUrl}}/orders/{id}", "host": ["{{baseUrl}}"], "path": ["orders","{id}"], "variable": [{"key":"id","value":"{orderId}"}] } } },
        { "name": "Cancel order (auth)", "request": { "method": "PATCH", "header":[{"key":"Authorization","value":"Bearer {{authToken}}"}], "url": { "raw": "{{baseUrl}}/orders/{id}/cancel", "host": ["{{baseUrl}}"], "path": ["orders","{id}","cancel"], "variable": [{"key":"id","value":"{orderId}"}] } } },
        { "name": "Get all orders (admin)", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/orders/admin/all", "host": ["{{baseUrl}}"], "path": ["orders","admin","all"] } } },
        { "name": "Update order status (admin)", "request": { "method": "PATCH", "header":[{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\n  \"status\": \"preparing\"\n}"}, "url": { "raw": "{{baseUrl}}/orders/admin/{id}/status", "host": ["{{baseUrl}}"], "path": ["orders","admin","{id}","status"], "variable": [{"key":"id","value":"{orderId}"}] } } }
      ]
    },
    {
      "name": "User",
      "item": [
        { "name": "Update profile (auth)", "request": { "method": "PUT", "header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{authToken}}"}], "body": {"mode":"raw","raw":"{\n  \"name\": \"New Name\",\n  \"address\": { \"street\": \"X\" }\n}"}, "url": { "raw": "{{baseUrl}}/user/profile", "host": ["{{baseUrl}}"], "path": ["user","profile"] } } },
        { "name": "Add favorite (auth)", "request": { "method": "POST", "header":[{"key":"Authorization","value":"Bearer {{authToken}}"}], "url": { "raw": "{{baseUrl}}/user/favorites/{menuItemId}", "host": ["{{baseUrl}}"], "path": ["user","favorites","{menuItemId}"], "variable": [{"key":"menuItemId","value":"{menuId}"}] } } },
        { "name": "Remove favorite (auth)", "request": { "method": "DELETE", "header":[{"key":"Authorization","value":"Bearer {{authToken}}"}], "url": { "raw": "{{baseUrl}}/user/favorites/{menuItemId}", "host": ["{{baseUrl}}"], "path": ["user","favorites","{menuItemId}"], "variable": [{"key":"menuItemId","value":"{menuId}"}] } } },
        { "name": "Get favorites (auth)", "request": { "method": "GET", "header":[{"key":"Authorization","value":"Bearer {{authToken}}"}], "url": { "raw": "{{baseUrl}}/user/favorites", "host": ["{{baseUrl}}"], "path": ["user","favorites"] } } }
      ]
    },
    {
      "name": "Uploads",
      "item": [
        {
          "name": "Upload image (multipart)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Authorization", "value": "Bearer {{authToken}}" } ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "image", "type": "file", "src": "" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/uploads", "host": ["{{baseUrl}}"], "path": ["uploads"] }
          }
        }
      ]
    }
  ]
}
